# Leave this UNSET for local development — Vite's dev server proxy
# (see vite.config.js) already forwards /api to http://localhost:5000.
#
# Set this ONLY for production builds (Vercel), pointing at your deployed
# Render backend URL. No trailing slash, no /api suffix — that's added
# automatically.
#
# VITE_API_URL=https://cinevault-server.onrender.com
