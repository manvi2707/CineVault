# ─────────────────────────────────────────────
# These are the environment variables to set in
# Render's dashboard (Settings → Environment).
# Do NOT commit a real .env.production file —
# this is reference only.
# ─────────────────────────────────────────────

PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/cinevault?retryWrites=true&w=majority
JWT_SECRET=<a long random string — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))">
NODE_ENV=production
TMDB_API_KEY=<your TMDB v3 API key>
TMDB_BASE_URL=https://api.themoviedb.org/3

# Your live Vercel frontend URL(s), comma-separated if you have more than one
# (e.g. production + a preview deployment). No trailing slash.
CLIENT_URL=https://your-app.vercel.app
